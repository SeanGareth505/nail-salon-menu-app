rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTherapistAuth() {
      return isSignedIn()
        && request.auth.token.email.matches('^t-.+@staff\\.salonflow\\.internal$');
    }

    function isKiosk() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.kiosk == true
      );
    }

    function isAdmin() {
      return isSignedIn() && !isTherapistAuth() && !isKiosk();
    }

    function isStaff() {
      return isAdmin() || isTherapistAuth();
    }

    function isStaffOrKiosk() {
      return isStaff() || isKiosk();
    }

    match /signatures/{fileName} {
      allow read: if isStaffOrKiosk();
      allow write: if isStaffOrKiosk()
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /consultation-images/{consultationId}/{fileName} {
      allow read: if isStaffOrKiosk();
      allow write: if isStaffOrKiosk()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /branding/{fileName} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    match /catalogue/{path=**} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
