rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isTherapistAuth() {
      return isSignedIn()
        && request.auth.token.email.matches('^t-.+@staff\\.salonflow\\.internal$');
    }

    function isKiosk() {
      return isSignedIn() && (
        request.auth.token.firebase.sign_in_provider == 'anonymous' ||
        request.auth.token.kiosk == true
      );
    }

    function isAdmin() {
      return isSignedIn() && !isTherapistAuth() && !isKiosk();
    }

    function isStaff() {
      return isAdmin() || isTherapistAuth();
    }

    function isStaffOrKiosk() {
      return isStaff() || isKiosk();
    }

    function therapistDoc(therapistId) {
      return get(/databases/$(database)/documents/therapists/$(therapistId));
    }

    function tapTabletSignInAllowed(therapistId) {
      return therapistDoc(therapistId).data.active == true
        && therapistDoc(therapistId).data.get('pinEnabled', false) != true;
    }

    match /salonSettings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /branding/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /treatments/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /therapists/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /therapistStaffAccess/{therapistId} {
      allow read: if isAdmin() || tapTabletSignInAllowed(therapistId);
      allow write: if isAdmin();
    }

    match /specials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /consentTemplates/{docId} {
      allow read: if isStaffOrKiosk();
      allow write: if isAdmin();
    }

    match /consentTemplateVersions/{docId} {
      allow read: if isStaffOrKiosk();
      allow create: if isAdmin();
      allow update: if isAdmin() && (
        resource.data.status != 'published' ||
        (request.resource.data.steps == resource.data.steps &&
         request.resource.data.fields == resource.data.fields)
      );
      allow delete: if false;
    }

    match /clients/{docId} {
      allow read, write: if isStaffOrKiosk();
    }

    match /consultations/{docId} {
      allow read, write: if isStaffOrKiosk();
    }

    match /consentSubmissions/{docId} {
      allow read: if isStaffOrKiosk();
      allow create: if isStaffOrKiosk();
      allow update: if isStaffOrKiosk() && (
        (request.resource.data.answers == resource.data.answers &&
         request.resource.data.signature == resource.data.signature) ||
        (resource.data.status == 'pending' &&
         request.resource.data.status == 'complete' &&
         request.resource.data.answers == resource.data.answers &&
         request.resource.data.signature == resource.data.signature)
      );
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if isAdmin() && resource.data.recipientUid == request.auth.uid;
      allow create: if isStaffOrKiosk();
      allow update: if isAdmin()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    match /auditEvents/{docId} {
      allow read: if isAdmin();
      allow create: if isStaffOrKiosk();
      allow update, delete: if false;
    }
  }
}
